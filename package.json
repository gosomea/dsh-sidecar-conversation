{
  "name": "dsh-sidecar-conversation",
  "version": "0.2.6",
  "description": "Conversation-bound chats in the native DeepSeek Harness sidebar",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "sidecar",
    "conversation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gosomea/dsh-sidecar-conversation.git"
  },
  "homepage": "https://github.com/gosomea/dsh-sidecar-conversation#readme",
  "bugs": {
    "url": "https://github.com/gosomea/dsh-sidecar-conversation/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json && tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "watch": "tsdown --watch",
    "prepare": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-permission-presets": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-alpha.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-session-turn-outline": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.3",
    "@shikijs/langs": "^4.4.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "immer": "^10.2.0",
    "jsdom": "^26.1.0",
    "katex": "^0.18.7",
    "lightningcss": "^1.29.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.3",
    "simple-icons": "16.31.0",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4",
    "zustand": "~4.5.7"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0"
}
